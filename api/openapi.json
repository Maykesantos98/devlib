{
  "openapi": "3.1.0",
  "info": {
    "title": "DEVLIB Catalog API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/catalog.json": {
      "get": {
        "summary": "Catálogo completo para agentes",
        "responses": {
          "200": {
            "description": "133 recursos DEVLIB"
          }
        }
      }
    },
    "/api/categories.json": {
      "get": {
        "summary": "Categorias e totais",
        "responses": {
          "200": {
            "description": "Categorias"
          }
        }
      }
    },
    "/llms.txt": {
      "get": {
        "summary": "Instruções de descoberta para LLMs",
        "responses": {
          "200": {
            "description": "Guia"
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "summary": "MCP Streamable HTTP",
        "responses": {
          "200": {
            "description": "Resposta MCP"
          }
        }
      }
    },
    "/api/ai/recommend": {
      "post": {
        "summary": "Recomenda stack fundamentada",
        "responses": {
          "200": {
            "description": "Stack por camadas"
          },
          "400": {
            "description": "Entrada inválida"
          }
        }
      }
    },
    "/api/ai/search": {
      "get": {
        "summary": "Busca dinâmica no catálogo",
        "responses": {
          "200": {
            "description": "Resultados"
          }
        }
      }
    },
    "/api/ai/explain": {
      "get": {
        "summary": "Explica conceitos com fontes",
        "responses": {
          "200": {
            "description": "Explicação fundamentada"
          }
        }
      }
    }
  }
}
