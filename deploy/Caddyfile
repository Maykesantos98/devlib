{$DEVLIB_DOMAIN} {
  encode zstd gzip
  handle /mcp* {
    basic_auth {
      devlib {$DEVLIB_MCP_PASSWORD_HASH}
    }
    reverse_proxy agent:8000
  }
  reverse_proxy devlib:8080

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
  }

  log {
    output stdout
    format console
  }
}
